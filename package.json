{
  "name": "inhouse",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Inhouse — AI app builder local (conductor + lovable) que usa o Claude Code da própria máquina",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs dev",
    "dev:fake": "node scripts/dev.mjs fake",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "debug": "tsx server/debug/runJourneys.ts",
    "build:mac": "scripts/build-mac-app.sh",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.0",
    "express": "^4.21.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
